# AdmissionOS Supabase public configuration.
# Use a dedicated AdmissionOS project; do not reuse another product database.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Optional server-only key. Do not expose with NEXT_PUBLIC_ and do not use unless a narrowly scoped server operation requires it.
# SUPABASE_SERVICE_ROLE_KEY=replace_me
